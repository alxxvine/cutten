{
  "name": "cutten",
  "version": "2.0.0",
  "private": true,
  "description": "Dragon Meadow — a 3D low-poly virtual pet",
  "scripts": {
    "vendor": "echo \"export * from 'three';\" > .three-entry.js && esbuild .three-entry.js --bundle --minify --format=iife --global-name=THREE --outfile=vendor/three.min.js --legal-comments=none && rm .three-entry.js",
    "serve": "python3 -m http.server 8000",
    "build:single": "node tools/build-single.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "0.185.1"
  }
}
